# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
/.sites-package-stage/
/package-stage-*/
/.package-cache/

# Local document and presentation QA artifacts; source documents remain tracked.
/qa_seminar8*/
/documentation/qa_render*/
/.codex-pptx/
__pycache__/
*.py[cod]

# Unused framework prototype files; production uses the dependency-free Worker.
/.npmrc
/build/
/cloudflare-env.d.ts
/components.json
/components/
/db/
/drizzle.config.ts
/eslint.config.mjs
/examples/
/hooks/
/lib/
/next.config.ts
/postcss.config.mjs
/scripts/
/tsconfig.json
/vendor/
/vite.config.ts
/app/api/
/app/chatgpt-auth.ts
/app/globals.css
/app/layout.tsx
/app/route.ts
/public/file.svg
/public/globe.svg
/public/window.svg
